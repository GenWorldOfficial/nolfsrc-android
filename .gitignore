# The disc images (you provide them; see ISOS/README.md). SHA256SUMS and
# README.md are tracked.
/ISOS/*.iso

# The compilers (see toolchain/README.md, which is tracked)
/toolchain/*
!/toolchain/README.md
!/toolchain/COMPILERS.md
!/toolchain/fetch.sh

# Everything the build writes
/out/
# worktrees made by tools/agentwt.sh
/.worktrees/
src/engine/*/Release/
src/lithshared/*/Release/
src/lithshared/out/
src/game/*/Release/
src/game/*/Debug/
src/game/*/Final_*/
src/engine/*/link/aliases.obj
src/engine/*/link/vtables.obj
src/engine/*/link/ddraw7.lib
src/engine/*/link/mss32dec.lib
src/engine/d3d/link/d3dviews.obj
# generated from the disc at build time (build/all.sh steps 2b, 2c)
src/engine/launcher/res/
src/game/ClientRes/goty/
# generated by flex/bison at build time
src/game/ObjectDLL/AnimationLex.cpp
src/game/ObjectDLL/AnimationParse.cpp
src/game/ObjectDLL/animationparse.cpp
src/game/ObjectDLL/AnimationLexSymbols.h

__pycache__/
*.log

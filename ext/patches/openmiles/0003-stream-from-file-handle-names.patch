+// Miles names an already-open Win32 file handle as "\\<handle in decimal>":
+// the stream is read from the handle's current position, and the handle stays
+// the caller's (it is neither moved back nor closed). LithTech streams a sound
+// stored inside a .rez archive this way, with the handle seeked to the
+// sound's offset in the archive.
+const win32 = if (builtin.os.tag == .windows) struct {
+    extern "kernel32" fn ReadFile(hFile: ?*anyopaque, lpBuffer: [*]u8, nNumberOfBytesToRead: u32, lpNumberOfBytesRead: *u32, lpOverlapped: ?*anyopaque) callconv(.winapi) i32;
+} else struct {};
+
+fn handleFromStreamName(name: []const u8) ?*anyopaque {
+    if (name.len < 3 or name[0] != '\\' or name[1] != '\\') return null;
+    const n = std.fmt.parseInt(u32, name[2..], 10) catch return null;
+    if (n == 0) return null;
+    return @ptrFromInt(n);
+}
+
+fn readExactFromHandle(h: ?*anyopaque, buf: []u8) !void {
+    var off: usize = 0;
+    while (off < buf.len) {
+        const want: u32 = @intCast(@min(buf.len - off, 1 << 20));
+        var got: u32 = 0;
+        if (win32.ReadFile(h, buf.ptr + off, want, &got, null) == 0 or got == 0) return error.ReadFailed;
+        off += got;
+    }
+}
+
+// The handle is usually a whole archive, so its end is not the sound's: read
+// the RIFF header and then exactly the bytes it says the file holds.
+fn readRiffFromHandle(allocator: std.mem.Allocator, h: ?*anyopaque) ![]u8 {
+    var hdr: [8]u8 = undefined;
+    try readExactFromHandle(h, &hdr);
+    if (!std.mem.eql(u8, hdr[0..4], "RIFF")) return error.NotRiff;
+    const body = std.mem.readInt(u32, hdr[4..8], .little);
+    if (body < 4 or body > 256 * 1024 * 1024) return error.BadRiffSize;
+    const buf = try allocator.alloc(u8, @as(usize, body) + 8);
+    errdefer allocator.free(buf);
+    @memcpy(buf[0..8], &hdr);
+    try readExactFromHandle(h, buf[8..]);
+    return buf;
+}
+
 pub fn AIL_close_stream(s_opt: ?*Sample) callconv(.winapi) void {
     const s = s_opt orelse return;
     log("AIL_close_stream(s={*})\n", .{s});

DETAIL DIALOG DISCARDABLE 0, 0, 273, 257
STYLE WS_POPUP | WS_CAPTION | DS_CENTER | DS_MODALFRAME | DS_SETFONT
CAPTION "NOLF - Performance Settings"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Select &Average Performance",1047,"Button",0x30001,86,143,100,16
    CONTROL         "Select High &Detail",1048,"Button",0x30000,86,209,100,16
    CONTROL         "Cancel",2,"Button",0x30000,86,234,100,16

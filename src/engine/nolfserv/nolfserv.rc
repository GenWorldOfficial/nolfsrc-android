/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,2
 PRODUCTVERSION 1,0,0,2
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "monolith@lith.com"
            VALUE "CompanyName", "Monolith Productions Inc."
            VALUE "FileDescription", "NOLF Stand-Alone Server"
            VALUE "FileVersion", "1, 0, 0, 2"
            VALUE "InternalName", "NolfServ"
            VALUE "LegalCopyright", "Copyright (C) 2000, Monolith Productions, Inc."
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFilename", "NolfServ.exe"
            VALUE "PrivateBuild", ""
            VALUE "ProductName", "NOLF"
            VALUE "ProductVersion", "1, 0, 0, 2"
            VALUE "SpecialBuild", ""
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END


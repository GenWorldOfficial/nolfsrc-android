// nolfserv.rc -- NolfServ.exe's resources, reconstructed from the retail
// NolfServ.exe (Game of the Year Edition; FileVersion 1,0,0,2): the server
// dialog, the setup wizard's pages, the string table and the version.
// The icons and the wizard's bitmap are read out of the retail image into
// res/ at build time (tools/retailextract.py nolfservres); the rest of its
// binary resources are MFC's, from the toolchain's afxres.rc, as in any
// statically linked MFC application of its day.

#include "resource.h"
#include "afxres.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

IDR_MAINFRAME           ICON    DISCARDABLE     "res\\nolfserv.ico"
IDI_SELECTED            ICON    DISCARDABLE     "res\\selected.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDB_WIZARD              BITMAP  DISCARDABLE     "res\\wizard.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

